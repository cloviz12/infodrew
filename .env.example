DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Obligatoria: elige la contraseña con la que entrarás al panel de
# moderación en /admin. No tiene valor por defecto a propósito.
ADMIN_PASSWORD="change-me"

# Opcional: si no se define, se deriva automáticamente de DATABASE_URL
# (ver lib/auth.ts). Solo defínela si quieres un secreto independiente.
SESSION_SECRET=""

SITE_URL="https://your-project.vercel.app"
